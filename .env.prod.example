# Configuration de Production CollectPro
SPRING_PROFILES_ACTIVE=prod

# Base de données PostgreSQL
DB_USERNAME=collectepro_user
DB_PASSWORD=change_this_strong_password_in_prod

# Clé secrète JWT (Générer avec: openssl rand -base64 64)
JWT_SECRET=change_this_jwt_secret_key_in_production_environment_with_strong_random_string

# Serveur SMTP Mail (Ex: SendGrid, Mailgun, AWS SES)
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=your_sendgrid_api_key
MAIL_FROM=no-reply@collectpro.com

# Domaines & URLs de production
FRONTEND_URL=https://dashboard.collectpro.com
CORS_ALLOWED_ORIGINS=https://dashboard.collectpro.com

# Super Admin Initial
SUPER_ADMIN_EMAIL=admin@collectpro.com
SUPER_ADMIN_PASSWORD=change_super_admin_password
